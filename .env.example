# Copy this file to .env only when you need local overrides.
# The application reads these values from the environment.

TETHYSGUARD_APP_NAME=TethysGuard API
TETHYSGUARD_APP_VERSION=0.5.0
TETHYSGUARD_DATABASE_PATH=Backend/tethysguard.db
TETHYSGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TETHYSGUARD_MAX_REQUEST_BODY_BYTES=16384
TETHYSGUARD_FAILED_LOGIN_THRESHOLD=5
TETHYSGUARD_FAILED_LOGIN_WINDOW_MINUTES=5
TETHYSGUARD_CORRELATION_WINDOW_MINUTES=10
TETHYSGUARD_REPEATED_SCAN_THRESHOLD=3
TETHYSGUARD_SUSPICIOUS_HOST_THRESHOLD=3
TETHYSGUARD_ALERT_SUPPRESSION_MINUTES=5
